/*
 * Pellet module firmware on a NUCLEO-G474RE dev board.
 *
 * Same SoC as the pellet module, so every peripheral instance and DMAMUX request
 * line is kept identical to boards/arm/cerebellumlab_pellet_module; only the pins
 * move, onto pins that the Nucleo brings out on the Arduino/ST-morpho headers.
 * Nothing here is wired to real hardware - this exists so the firmware builds and
 * boots on the dev board.
 *
 *   ext_button_1   PC13  B1 (user button)      door_sensor_1  PB8   D15
 *   door_sensor_2  PB10  D6                    door_sensor_3  PA15  CN7-17
 *   CAN_ID[0..3]   PC10  PC11  PB0  PB1        STIM0..3       PB11..PB14
 *   rgb red/green/blue   PB5 (D4)  PB6 (D10)  PB7 (CN7-21)
 *   servo0/1/2     PA1 (A1)  PB15 (CN10-26)  PB9 (D14)
 *   stepper0 step/dir/limit  PC2  PC3  PA8 (D7)
 *   stepper1 step/dir/limit  PC9  PC6  PA9 (D8)
 *   stepper2 step/dir/limit  PC8  PC7 (D9)  PA10 (D2)
 *   TMC2209 UART   PC4/PC5 (D1/D0)            tone DAC/enable  PA4 (A2) / PA7 (D11)
 *   analog out     PA6 (D12)
 */

#include "nucleo_g474re_partitions.dtsi"

/ {
	aliases {
		/* pwmleds below is deleted, so this alias would dangle */
		/delete-property/ pwm-led0;
	};

	/* TIM2 drives the tone generator sample rate here, as on the pellet module,
	 * so it cannot also back the board's PWM LED. */
	/delete-node/ pwmleds;

	gpio_keys {
		compatible = "gpio-keys";

		door_sensor_1: door_sensor_1 {
			label = "Door Closed 1";
			gpios = <&gpiob 8 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			zephyr,code = <INPUT_KEY_5>;
			status = "okay";
		};

		door_sensor_2: door_sensor_2 {
			label = "Door Closed 2";
			gpios = <&gpiob 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			zephyr,code = <INPUT_KEY_6>;
			status = "okay";
		};

		door_sensor_3: door_sensor_3 {
			label = "Door Closed 3";
			gpios = <&gpioa 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			zephyr,code = <INPUT_KEY_7>;
			status = "okay";
		};
	};

	generic-gpios {
		status = "okay";
		compatible = "ll,generic-gpios";
		input-gpios = <&gpioc 10 GPIO_ACTIVE_LOW>,  // CAN_ID[0] / NodeNumber[0]
					  <&gpioc 11 GPIO_ACTIVE_LOW>,  // CAN_ID[1] / NodeNumber[1]
					  <&gpiob 0 GPIO_ACTIVE_HIGH>,  // CAN_ID[2] / DeviceType[0]
					  <&gpiob 1 GPIO_ACTIVE_HIGH>;  // CAN_ID[3] / DeviceType[1]
		input-gpio-names = "CAN_ID[0]",
						   "CAN_ID[1]",
						   "CAN_ID[2]",
						   "CAN_ID[3]";
		input-gpio-interrupt-enable = "DISABLE", "DISABLE", "DISABLE", "DISABLE";
		output-gpios = <&gpiob 11 GPIO_ACTIVE_HIGH>, // STIM0
					   <&gpiob 12 GPIO_ACTIVE_HIGH>, // STIM1
					   <&gpiob 13 GPIO_ACTIVE_HIGH>, // STIM2
					   <&gpiob 14 GPIO_ACTIVE_HIGH>; // STIM3
		output-gpio-names = "STIM0",
						    "STIM1",
						    "STIM2",
						    "STIM3";
		output-gpio-interrupt-enable = "DISABLE", "DISABLE", "DISABLE", "DISABLE";
	};

	tone_generator {
		compatible = "ll,tone-generator";
		status = "okay";

		sample-rate-timer = <&timers2>;
		dac = <&dac1>;
		dac-channel = <1>;
		dmas = <&dmamux1 6 6 STM32_DMA_PRIORITY_HIGH>;
		dma-names = "tx";
		enable-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
	};

	analog_out: analog_out {
		compatible = "ll,analog-out";
		status = "okay";
		io-channels = <&dac2 1>;
		resolution = <12>;
	};

	rgb_led: rgb-led {
		compatible = "pwm-leds";
		status = "okay";

		red_pwm_led: red_pwm_led {
			pwms = <&pwm3 2 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
			label = "red";
		};

		green_pwm_led_rgb: green_pwm_led_rgb {
			pwms = <&pwm4 1 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
			label = "green";
		};

		blue_pwm_led: blue_pwm_led {
			pwms = <&pwm4 2 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
			label = "blue";
		};
	};
};

/* The Nucleo's user button stands in for the external button input. */
ext_button_1: &user_button {
	label = "Ext Button 1";
};

/* Freed up so their pins can serve the peripherals above:
 * SPI1 PA5/PA6/PA7 + PB6, SPI2 PB12-PB15, SPI3 PA15 + PC10-PC12, I2C1 PB8/PB9. */
&spi1 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

/* jerrycan runs 1 Mbit/s nominal with a 5 Mbit/s data phase. Zephyr only accepts a
 * bit timing where core_clock % (prescaler * bitrate) == 0, and 5 Mbit/s is
 * unreachable from the board's 24 MHz HSE, so take the FDCAN kernel clock from
 * PCLK1 at 170 MHz as the pellet module board does. */
&fdcan1 {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x02000000>,
			 <&rcc STM32_SRC_PCLK FDCAN_SEL(1)>;
};

&dma1 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

&timers2 {
	status = "okay";
};

&pwm2 {
	status = "disabled";
};

&timers3 {
	st,prescaler = <84>; // 170 MHz / (84 + 1) = 2 MHz
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pb5>;
		pinctrl-names = "default";
	};
};

&timers4 {
	st,prescaler = <84>; // 170 MHz / (84 + 1) = 2 MHz
	status = "okay";

	pwm4: pwm {
		status = "okay";
		pinctrl-0 = <&tim4_ch1_pb6 &tim4_ch2_pb7>;
		pinctrl-names = "default";
	};
};

&timers5 {
	status = "okay";
	st,prescaler = <84>; // 170 MHz / (84 + 1) = 2 MHz

	servo0: servo0 {
		compatible = "ll,servo";
		status = "okay";

		pinctrl-0 = <&tim5_ch2_pa1>;
		pinctrl-names = "default";

		pwm-channel = <2>;

		dmas = <&dmamux1 0 76 STM32_DMA_PRIORITY_MEDIUM>;
		dma-names = "tx";
	};
};

&timers15 {
	status = "okay";
	st,prescaler = <84>; // 170 MHz / (84 + 1) = 2 MHz

	servo1: servo1 {
		compatible = "ll,servo";
		status = "okay";

		pinctrl-0 = <&tim15_ch2_pb15>;
		pinctrl-names = "default";

		pwm-channel = <2>;

		dmas = <&dmamux1 1 79 STM32_DMA_PRIORITY_MEDIUM>;
		dma-names = "tx";
	};
};

&timers17 {
	status = "okay";
	st,prescaler = <84>; // 170 MHz / (84 + 1) = 2 MHz

	servo2: servo2 {
		compatible = "ll,servo";
		status = "okay";

		pinctrl-0 = <&tim17_ch1_pb9>;
		pinctrl-names = "default";

		pwm-channel = <1>;

		dmas = <&dmamux1 2 85 STM32_DMA_PRIORITY_MEDIUM>;
		dma-names = "tx";
	};
};

&timers1 {
	status = "okay";
	st,prescaler = <849>; // 170 MHz / (849 + 1) = 200 kHz

	stepper0: stepper0 {
		compatible = "ll,stepper";
		status = "okay";

		pinctrl-0 = <&tim1_ch3_pc2>;
		pinctrl-names = "default";

		dir-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;

		pwm-channel = <3>;

		dmas = <&dmamux1 3 46 STM32_DMA_PRIORITY_MEDIUM>;
		dma-names = "tx";

		driver-dev = <&stepper_driver0>;
		limit-switch-gpios = <&gpioa 8 (GPIO_PULL_DOWN | GPIO_ACTIVE_LOW)>;
	};
};

&timers8 {
	status = "okay";
	st,prescaler = <849>; // 170 MHz / (849 + 1) = 200 kHz

	stepper1: stepper1 {
		compatible = "ll,stepper";
		status = "okay";

		pinctrl-0 = <&tim8_ch4_pc9>;
		pinctrl-names = "default";

		dir-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;

		pwm-channel = <4>;

		dmas = <&dmamux1 4 53 STM32_DMA_PRIORITY_MEDIUM>;
		dma-names = "tx";

		driver-dev = <&stepper_driver1>;
		limit-switch-gpios = <&gpioa 9 (GPIO_PULL_DOWN | GPIO_ACTIVE_LOW)>;
	};
};

&timers20 {
	status = "okay";
	st,prescaler = <849>; // 170 MHz / (849 + 1) = 200 kHz

	stepper2: stepper2 {
		compatible = "ll,stepper";
		status = "okay";

		pinctrl-0 = <&tim20_ch3_pc8>;
		pinctrl-names = "default";

		dir-gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;

		pwm-channel = <3>;

		dmas = <&dmamux1 5 90 STM32_DMA_PRIORITY_MEDIUM>;
		dma-names = "tx";

		driver-dev = <&stepper_driver2>;
		limit-switch-gpios = <&gpioa 10 (GPIO_PULL_DOWN | GPIO_ACTIVE_LOW)>;
	};
};

/* The pellet module talks to the TMC2209s on USART2; that one is the ST-LINK
 * virtual COM port here, so the drivers move to USART1 on the Arduino D0/D1 pins. */
&usart1 {
	current-speed = <230400>;
	parity = "none";
	stop-bits = "1";
	data-bits = <8>;
	pinctrl-0 = <&usart1_tx_pc4 &usart1_rx_pc5>;
	pinctrl-names = "default";
	#size-cells = <0>;
	#address-cells = <1>;
	status = "okay";
	fifo-enable;

	stepper_driver0: stepper_driver0@0 {
		compatible = "adi,tmc2209";
		reg = <0x00>;
		status = "okay";
	};

	stepper_driver1: stepper_driver1@1 {
		compatible = "adi,tmc2209";
		reg = <0x01>;
		status = "okay";
	};

	stepper_driver2: stepper_driver2@2 {
		compatible = "adi,tmc2209";
		reg = <0x02>;
		status = "okay";
	};
};

&dac2 {
	pinctrl-0 = <&dac2_out1_pa6>;
	pinctrl-names = "default";
	status = "okay";
};

/* Pull-downs on the stepper STEP pins, as on the pellet module. */
&tim1_ch3_pc2 {
	bias-pull-down;
};

&tim8_ch4_pc9 {
	bias-pull-down;
};

&tim20_ch3_pc8 {
	bias-pull-down;
};
