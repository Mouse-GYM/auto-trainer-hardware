menuconfig LIB_MOTOR_MOTION
    bool "Enable the motor motion mathematics library"
    default n
    depends on FPU
    select SETTINGS
    select LL_SERVO if DT_HAS_LL_SERVO_ENABLED
    select LL_STEPPER if DT_HAS_LL_STEPPER_ENABLED
    depends on LIB_MOTOR_MOTION_WORK_QUEUE_PRIORITY < 0
    depends on LIB_MOTOR_MOTOIN_SETTINGS_WORK_QUEUE_PRIORITY > 90
    depends on LIB_MOTOR_MOTION_WORK_QUEUE_STACK_SIZE > 0
    depends on LIB_MOTOR_MOTION_SETTINGS_WORK_QUEUE_STACK_SIZE > 0
    help
      Enable the library that calculates motor motion based on sinusoidal motion profiles.

menuconfig LIB_MOTOR_MOTION_LOG_LEVEL
    int "Log level for the motor motion mathematics library"
    default 4
    depends on LIB_MOTOR_MOTION
    help
      Set the log level for the motor motion math library.

menuconfig LIB_MOTOR_MOTION_SHELL
    bool "Enable the shell for the motor motion mathematics library"
    default n
    depends on LIB_MOTOR_MOTION
    help
      Enable the shell for the motor motion math library

config LIB_MOTOR_MOTION_WORK_QUEUE_PRIORITY
  int "Thread priority for the motor motion work queue"
  default 0
  range -16 0

config LIB_MOTOR_MOTION_SETTINGS_WORK_QUEUE_PRIORITY
  int "Thread priority for background settings saves"
  default 89
  range 89 99

config LIB_MOTOR_MOTION_WORK_QUEUE_STACK_SIZE
  int "Work queue thread stack size"
  default 0

config LIB_MOTOR_MOTION_SETTINGS_WORK_QUEUE_STACK_SIZE
  int "Settings work queue thread stack size"
  default 0

config LIB_MOTOR_MOTION_STEPPER_MONITOR_PRIORITY
  int "Thread priority for the stepper protection monitor"
  default 5
  help
    The monitor polls each moving stepper's driver over its UART (about 10 ms per read), so it runs on its
    own work queue, below the motion work queue that refills the step buffers.

config LIB_MOTOR_MOTION_STEPPER_MONITOR_STACK_SIZE
  int "Stepper protection monitor thread stack size"
  default 1024

config LIB_MOTOR_MOTION_STEPPER_MOVE_TIMEOUT_PERCENT
  int "Stepper move timeout, as a percentage of the nominal move time"
  default 150
  range 100 1000
  help
    A stepper move faults if it hasn't finished within this percentage of its nominal duration,
    distance / velocity + 2 * velocity / acceleration, plus LIB_MOTOR_MOTION_STEPPER_MOVE_TIMEOUT_MARGIN_MS.

config LIB_MOTOR_MOTION_STEPPER_MOVE_TIMEOUT_MARGIN_MS
  int "Stepper move timeout margin (ms)"
  default 500
  range 0 60000
  help
    Fixed time added to every stepper move and homing timeout, so short moves aren't timed too tightly.

config LIB_MOTOR_MOTION_STEPPER_HOMING_MAX_TRAVEL
  int "Longest distance a stepper can travel while homing"
  default 40
  range 1 10000
  help
    In the same units as move positions, which the host's steps_per_revolution setting defines (millimetres
    on the pellet module). Homing stops stepping once it has covered this distance and faults with a move
    timeout if it hasn't reached the limit switch. It is also timed like a move of this distance at the homing
    velocity and the motor's maximum acceleration, in case the steps stall.